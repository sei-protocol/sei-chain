# Source capture
MAINNET_RPC=""
COSMOS_RPC=""
REPLAY_DIR=runtime/replay/pacific-1/pacific-1-20m
RECORD_MINUTES=20
SEGMENT_BLOCKS=200
TIP_LAG_BLOCKS=10
RPC_CONCURRENCY=2
COSMOS_RPC_CONCURRENCY=6
BLOCKS_PER_BATCH=20
# Tracing is RPC/CPU intensive. "calls" captures only bounded call topology;
# "full" also requests lightweight structLogs and prestate diff summaries.
TRACE_CAPTURE_MODE=calls
TRACE_CONCURRENCY=1
TRACE_MAX_DEPTH=8
TRACE_MAX_FRAMES=64
TRACE_TIMEOUT_MS=30000
TRACE_MAX_RETRIES=3

# Every target must set its name, chain IDs, and RPC URLs explicitly.
TARGET_NETWORK=""
TARGET_EVM_CHAIN_ID=""
TARGET_COSMOS_CHAIN_ID=""
TARGET_EVM_RPC=""
TARGET_COSMOS_RPC=""
# Put the mnemonic only in your ignored .env file. Never commit it.
TARGET_MNEMONIC=""
# One-time isolated runner account preparation.
# RUNNER_MNEMONIC_PATH=runtime/runner.mnemonic
# RUNNER_ACCOUNT_FUND_SEI=2000001000
# LOAD_USERS=runtime/replay-users/arctic-1-100.json # Optional path override.
# Schema v5 adds token-operation fixtures.
LOAD_DEPLOYMENT=runtime/replay-deployments/arctic-1-v5.json

# Safety: set to 1 only when deployment, funding, or replay mutations are intended.
EXECUTE=0
USER_COUNT=100
# Target balance per worker. Large exact decimal values are supported.
FUND_SEI=100
TIME_SCALE=1
MAX_TPS=25
# Generated load derives workers as ceil(TXS_PER_SECOND * USERS_PER_TPS).
USERS_PER_TPS=2
MAX_WORKER_COUNT=200
# WORKER_COUNT=20 # Optional explicit override; replay defaults to 20.
# Reserve a fixed range so concurrent processes never share accounts.
USERS_PER_PARTITION=200
# Each process uses a disjoint range: offset = PARTITION_INDEX * USERS_PER_PARTITION.
PARTITION_INDEX=0
# WORKER_INDEX_OFFSET=0 # Optional explicit range override.
# USER_COUNT=2000 # One-time provision command size for a shared user pool.
MAX_PENDING_PER_LANE=2
MAX_GAS_PER_TX=5000000
MAX_CALLDATA_BYTES=131072
MAX_COSMOS_BYTES=1000000
MAX_COSMOS_MESSAGES=10
EVM_RECEIPT_TIMEOUT_MS=60000
MAX_VALUE_WEI=1000000000000000
PRIVILEGED_REPLAY_MODE=shape
# Startup may submit roughly 10-15 idempotent preparation transactions per new worker.
# Arctic gas estimation can underprice proxy/delegatecall paths; use an explicit ceiling.
FIXTURE_PREPARE_GAS_LIMIT=2000000
# SKIP_FIXTURE_PREPARE=1
# Set only when intentionally replaying the corpus again from its first block.
# REPLAY_FROM_START=1

# Unified generated load. RUN_ID must be unique per executing process or pod.
LOAD_TYPE=defi
TXS_PER_SECOND=10
# Per-process safety ceiling. Raise explicitly for intentional high-rate tests.
MAX_SYNTHETIC_TPS=100
RUN_ID=""
LOAD_RUNTIME_DIR=runtime/load-runs/local
# Synthetic transaction audits rotate at this size and retain this many old files.
LOAD_AUDIT_MAX_BYTES=104857600
LOAD_AUDIT_RETAIN_FILES=5
# Optional comma-separated operation weights, for example:
# LOAD_MIX=swap_a_to_b:40,swap_b_to_a:40,lend_supply:20
# CW1155_CONTRACT=sei1...
# SIMULATE_MODE=buffered

# Continuous mode and metrics
BUFFER_START_MODE=latest
INITIAL_BUFFER_BLOCKS=200
# Buffered mode deletes consumed capture segments and keeps the newest completed one.
CLEANUP_CONSUMED_SEGMENTS=1
RETAIN_COMPLETED_SEGMENTS=1
CLEANUP_INTERVAL_BLOCKS=200
MIN_BUFFER_MINUTES=5
RESUME_BUFFER_MINUTES=20
RUN_DURATION_HOURS=2
# RUN_DURATION_SECONDS=7200 # Optional higher-priority override for short runs.
SOURCE_POLL_MS=2000
# Set to 0.0.0.0 only when using the bundled Docker dashboard.
METRICS_HOST=127.0.0.1
METRICS_PORT=9465
