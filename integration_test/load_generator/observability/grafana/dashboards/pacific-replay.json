          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (lane) (rate(pacific_replay_offered_transactions_total{lane=~\"$lane\"}[$__rate_interval]))",
          "legendFormat": "offered · {{lane}}",
          "refId": "A"
