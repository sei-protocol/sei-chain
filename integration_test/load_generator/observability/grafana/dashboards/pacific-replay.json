        {
          "editorMode": "code",
          "expr": "sum by (lane) (rate(pacific_replay_transaction_outcomes_total{lane=~\"$lane\",outcome=\"included\"}[$__rate_interval]))",
          "legendFormat": "receipts · {{lane}}",
          "refId": "B"
        }
      ],
      "title": "Source offered vs target receipt TPS",
      "type": "timeseries"
    },
    {
      "datasource": {
