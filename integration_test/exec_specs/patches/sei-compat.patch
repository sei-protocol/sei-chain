@@ -26,6 +29,90 @@ from .base import BaseExecute, ExecuteResult
 
 logger = get_logger(__name__)
 
+POST_STATE_MISMATCH_ERRORS = (
+    AssertionError,
+    Account.NonceMismatchError,
+    Account.BalanceMismatchError,
+    Account.CodeMismatchError,
+    Storage.MissingKeyError,
+    Storage.KeyValueMismatchError,
+)
+
+
+def _assert_post_alloc(expected_alloc: Alloc, actual_alloc: Alloc) -> None:
+    """Assert that the fetched allocation matches the expected post-state."""
+    for address, expected_account in expected_alloc.root.items():
+        actual_account = actual_alloc.root[address]
+        assert actual_account is not None
+        if expected_account is None:
+            assert actual_account.balance == 0, (
+                f"Balance of {address} is {actual_account.balance}, "
+                "expected 0."
+            )
+            assert actual_account.code == b"", (
+                f"Code of {address} is {actual_account.code}, expected 0x."
+            )
+            assert actual_account.nonce == 0, (
+                f"Nonce of {address} is {actual_account.nonce}, expected 0."
+            )
+        else:
+            expected_account.check_alloc(address, actual_account)
+
+
+def _wait_for_post_alloc(
+    eth_rpc: EthRPC,
+    expected_alloc: Alloc,
+    transaction_hashes: List[Hash] | None = None,
+) -> None:
+    """Wait briefly for post-state RPC reads to catch up with the receipt."""
+    timeout = float(os.getenv("EEST_POST_STATE_WAIT_TIMEOUT", "2"))
+    poll_interval = float(os.getenv("EEST_POLL_INTERVAL", "0.2"))
+    deadline = time.monotonic() + timeout
+    attempt = 0
+
+    while True:
+        attempt += 1
+        try:
+            actual_alloc = eth_rpc.get_alloc(expected_alloc)
+            _assert_post_alloc(expected_alloc, actual_alloc)
+            if attempt > 1:
+                logger.info(
+                    "Post-state became visible after %d attempts.", attempt
+                )
+            return
+        except POST_STATE_MISMATCH_ERRORS:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                for tx_hash in transaction_hashes or []:
+                    try:
+                        receipt = eth_rpc.get_transaction_receipt(tx_hash)
+                    except Exception as error:
+                        logger.error(
+                            "Could not fetch receipt for %s: %s",
+                            tx_hash,
+                            error,
+                        )
+                        continue
+                    if receipt is None:
+                        logger.error(
+                            "No receipt found for transaction %s.", tx_hash
+                        )
+                        continue
+                    logger.error(
+                        "Persistent post-state mismatch; transaction %s "
+                        "receipt status=%s gasUsed=%s blockNumber=%s",
+                        tx_hash,
+                        receipt.get("status"),
+                        receipt.get("gasUsed"),
+                        receipt.get("blockNumber"),
+                    )
+                raise
+            logger.info(
+                "Post-state not visible yet; retrying in %.3f seconds.",
+                min(poll_interval, remaining),
+            )
+            time.sleep(min(poll_interval, remaining))
+
 
