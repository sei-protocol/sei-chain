{
  "Comment": "Configuration for local smoke testing and debugging: a small account population, a short run, and a block rate held well below what the machine can do.",
  "Seed": 1337,
  "DataDir": "~/gigasim/data",
  "LogDir": "~/gigasim/logs",
  "TransactionsPerBlock": 100,
  "MaxBlocksPerSecond": 10,
  "MinimumNumberOfColdAccounts": 2000,
  "MinimumNumberOfDormantAccounts": 2000,
  "MinimumNumberOfErc20Contracts": 100,
  "RollbackWindow": 100,
  "PruneIntervalSeconds": 10,
  "CheckpointIntervalSeconds": 30,
  "CleanDataOnStart": true,
  "CleanDataOnExit": true
}
